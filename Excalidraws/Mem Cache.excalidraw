      "isDeleted": false,
      "boundElements": null,
      "updated": 1736016904068,
      "link": null,
      "locked": false,
      "text": "So this thing works perfectly for a single service, but \nlets talk about real scenarios assuming we've multiple \nservices. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So this thing works perfectly for a single service, but \nlets talk about real scenarios assuming we've multiple \nservices. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
