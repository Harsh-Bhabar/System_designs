    {
      "id": "Wxl3s5hftaAIrAieUVsD1",
      "type": "text",
      "x": 2329.6763666231745,
      "y": 446.50889440112064,
      "width": 594.6199340820312,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 958445691,
      "version": 301,
      "versionNonce": 1087509339,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1736016922968,
      "link": null,
      "locked": false,
      "text": "Simple - Add Read-Replicas to the caches. \nBased on the data sensitivity and latency tolerance, \nwe can consider trade-offs btw Sync and Async replications. \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Simple - Add Read-Replicas to the caches. \nBased on the data sensitivity and latency tolerance, \nwe can consider trade-offs btw Sync and Async replications. \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
