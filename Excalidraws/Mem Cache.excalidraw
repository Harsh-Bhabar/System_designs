    {
      "id": "ovj2DrLiQ0SFXo_TCPjov",
      "type": "text",
      "x": 1578.1600860287404,
      "y": 899.2279224069794,
      "width": 693.4799194335938,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 2109738619,
      "version": 777,
      "versionNonce": 570526773,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1736016913852,
      "link": null,
      "locked": false,
      "text": "Now, how do the Cache-client will know where these Caches are \nresiding? \nwe can maintain the config file, and store to S3, but that would \njust add and extra cost of having checking it that too very \nfrequently. \nOne better approach is to use an intermediate service like Zookeeper\nsuch that whenever an Cache server is added, it can add registry to \nZookeeper and Cache client works with the Zookeeper to get the list \nof updated Cache server. \n\n-- SO far we covered Scalability and Performant ---",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now, how do the Cache-client will know where these Caches are \nresiding? \nwe can maintain the config file, and store to S3, but that would \njust add and extra cost of having checking it that too very \nfrequently. \nOne better approach is to use an intermediate service like Zookeeper\nsuch that whenever an Cache server is added, it can add registry to \nZookeeper and Cache client works with the Zookeeper to get the list \nof updated Cache server. \n\n-- SO far we covered Scalability and Performant ---",
      "autoResize": true,
      "lineHeight": 1.25
    },
