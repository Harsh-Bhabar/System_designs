      "isDeleted": false,
      "boundElements": null,
      "updated": 1735997724410,
      "link": null,
      "locked": false,
      "text": "Strangler pattern\n    - used when refactoring from Monolithic to Microservice\n    - just have a controller to divert that flag.  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Strangler pattern\n    - used when refactoring from Monolithic to Microservice\n    - just have a controller to divert that flag.  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sdhPtMDb4l9FodMhH3odP",
      "type": "text",
      "x": 290.96244282375505,
      "y": 796.676539660301,
      "width": 486.4799499511719,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
