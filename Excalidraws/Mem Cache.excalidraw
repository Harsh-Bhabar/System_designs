    {
      "id": "Y-y3pJs1DSYgdU_1zBDOF",
      "type": "text",
      "x": 1565.5055278568866,
      "y": 495.4324752869267,
      "width": 687.43994140625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 824084725,
      "version": 503,
      "versionNonce": 1855369077,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1736016913851,
      "link": null,
      "locked": false,
      "text": "the idea behind this is that the Service A and B have their own \npurpose and we don't want the services to figure out where to \npick the data from or which Cache to update or where the cache lies. \n\nBut we don't really want this to be a separate service. just WHY.\n\nwe can simply just have it as a library or a module that lies in the\nService. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the idea behind this is that the Service A and B have their own \npurpose and we don't want the services to figure out where to \npick the data from or which Cache to update or where the cache lies. \n\nBut we don't really want this to be a separate service. just WHY.\n\nwe can simply just have it as a library or a module that lies in the\nService. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
