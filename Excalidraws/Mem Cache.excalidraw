      "seed": 975989019,
      "version": 615,
      "versionNonce": 265137371,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1736016922972,
      "link": null,
      "locked": false,
      "text": "Sync Replication - when we can't deal with Wrong data anytime. \nLike in Financial Systems.\nAsync - like in news feed, views count, etc. \n\none more thing here is SECURITY \nwe can;t put our cache servers outside out firewall. and can only be \naccessed by trusted sources, like LB or Servers. \nFor all these we'll also be needing monitoring, not just for the \nperformance, but also for the Security. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sync Replication - when we can't deal with Wrong data anytime. \nLike in Financial Systems.\nAsync - like in news feed, views count, etc. \n\none more thing here is SECURITY \nwe can;t put our cache servers outside out firewall. and can only be \naccessed by trusted sources, like LB or Servers. \nFor all these we'll also be needing monitoring, not just for the \nperformance, but also for the Security. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
